# Sao chép thành .env.local rồi chỉnh. Mọi biến đều tuỳ chọn.

# Địa chỉ công khai của site (dùng cho metadata, sitemap, robots). Mặc định: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# URL Google Apps Script nhận đơn hàng. Để trống = chế độ mock (đơn chỉ ghi ra console, không gửi đi đâu).
NEXT_PUBLIC_ORDER_ENDPOINT=
