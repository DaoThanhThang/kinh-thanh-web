# Sao chép thành .env.local rồi chỉnh. Mọi biến đều tuỳ chọn khi chạy local.

# Địa chỉ công khai của site (dùng cho metadata, sitemap, robots). Mặc định: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Cách gửi đơn từ trình duyệt. Để trống = POST tới /api/order (gửi email, khuyến nghị).
#   mock            = chỉ ghi console (demo)
#   https://script.google.com/.../exec = Google Apps Script (phương án thay thế)
NEXT_PUBLIC_ORDER_ENDPOINT=

# ---- Email nhận đơn (chỉ server, KHÔNG đặt tiền tố NEXT_PUBLIC_) ----
# Thiếu SMTP_HOST/SMTP_USER/SMTP_PASS: chế độ xem trước (ghi email + ảnh khay vào thư mục tạm, không gửi).
# Trên Vercel thiếu các biến này thì đơn bị từ chối.
# Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng", dán vào SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true cho cổng 465; false cho 587 (STARTTLS). Bỏ trống = tự theo cổng.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Địa chỉ gửi (Gmail luôn ghi đè bằng SMTP_USER). Bỏ trống = SMTP_USER.
MAIL_FROM=
# Email nhận đơn của cửa hàng. Mặc định abc@gmail.com (đổi khi có địa chỉ thật).
SHOP_ORDER_EMAIL=abc@gmail.com

# ---- Chatbot tư vấn (chỉ server) ----
# Khoá Anthropic API. Thiếu: local chạy chế độ thử (trả lời mẫu); trên Vercel nút chat tự ẩn.
ANTHROPIC_API_KEY=
# Đặt false để tắt chatbot ngay (cần redeploy). Mặc định bật.
CHAT_ENABLED=
# Ghi đè mô hình. Mặc định claude-haiku-5-5.
CHAT_MODEL=
